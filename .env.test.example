# Copy to .env.test (it is ignored by git) and fill in the values of your TEST Supabase project.
# Run the app against it with:  npm run dev -- --mode test
# Values here replace the ones in .env, so the live store is never touched.
VITE_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-TEST-PROJECT-PUBLISHABLE-KEY
# PayPal SANDBOX client id (never the live one)
VITE_PAYPAL_CLIENT_ID=YOUR-PAYPAL-SANDBOX-CLIENT-ID
